{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarecard",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // The admin UI is built by Vite into ui/dist and served through the ASSETS binding.
  // The Worker always runs first so it can route CardDAV and API traffic before
  // falling back to static files.
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // ONE SQLite-backed Durable Object holds all state (users, contacts, tombstones, settings).
  "durable_objects": {
    "bindings": [{ "name": "FLARECARD", "class_name": "FlareCardDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlareCardDO"] }],

  // Plain variables are managed in the Cloudflare dashboard (Worker -> Settings -> Variables
  // and Secrets, type "Text"), not here. keep_vars makes deploys leave them alone; a `vars`
  // block would overwrite dashboard values on every deploy. All of them are optional:
  //   PUBLIC_HOST                     - public hostname for .mobileconfig profiles / setup page
  //                                     (default: the request's Host header)
  //   ADMIN_BOOTSTRAP_USERNAME        - first admin's username (default "admin")
  //   AUTH_RATE_LIMIT_IP              - failed logins per client IP per window (default 60, 0 = off)
  //   AUTH_RATE_LIMIT_USER            - failed logins per username per window (default 15, 0 = off)
  //   AUTH_RATE_LIMIT_WINDOW_SECONDS  - rate-limit window (default 600)
  //   ACME_DIRECTORY_URL              - CA for automatic profile signing (default ZeroSSL, which is
  //                                     the CA reachable from Workers; Let's Encrypt fails with 525)
  "keep_vars": true,

  // Secrets (set with `wrangler secret put <NAME>` or in .dev.vars for local dev):
  //   ADMIN_BOOTSTRAP_PASSWORD  - creates the initial admin if no users exist
  //   SESSION_SECRET            - optional; HMAC key for admin session cookies (auto-generated if absent)
  //   PROFILE_SIGNING_KEY       - optional; PEM private key to sign .mobileconfig profiles with
  //   PROFILE_SIGNING_CERT      - optional; PEM certificate chain for that key (leaf first)
  //                               (when both are set they take precedence over the automatic
  //                               ACME certificate managed from the admin UI)
  //   ACME_EAB_KID              - External Account Binding key id (ZeroSSL / Google Trust Services)
  //   ACME_EAB_HMAC_KEY         - External Account Binding HMAC key (base64url) from the same CA
}
