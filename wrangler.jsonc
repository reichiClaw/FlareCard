{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flarecard",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // The admin UI is built by Vite into ui/dist and served through the ASSETS binding.
  // The Worker always runs first so it can route CardDAV and API traffic before
  // falling back to static files.
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  // ONE SQLite-backed Durable Object holds all state (users, contacts, tombstones, settings).
  "durable_objects": {
    "bindings": [{ "name": "FLARECARD", "class_name": "FlareCardDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlareCardDO"] }],

  "vars": {
    // Public-facing hostname used in generated .mobileconfig profiles and setup pages.
    // Leave empty to derive it from the incoming Host header.
    "PUBLIC_HOST": "",
    // Username of the first admin created from ADMIN_BOOTSTRAP_PASSWORD.
    "ADMIN_BOOTSTRAP_USERNAME": "admin",
    // Built-in auth rate limiting: failed attempts allowed per client IP / per username
    // within the window before 429s are returned. Successful logins reset the counters.
    "AUTH_RATE_LIMIT_IP": "60",
    "AUTH_RATE_LIMIT_USER": "15",
    "AUTH_RATE_LIMIT_WINDOW_SECONDS": "600",
    // ACME directory used for automatic profile-signing certificates. Empty = Let's Encrypt
    // production. Use https://acme-staging-v02.api.letsencrypt.org/directory while testing.
    "ACME_DIRECTORY_URL": ""
  }

  // Secrets (set with `wrangler secret put <NAME>` or in .dev.vars for local dev):
  //   ADMIN_BOOTSTRAP_PASSWORD  - creates the initial admin if no users exist
  //   SESSION_SECRET            - optional; HMAC key for admin session cookies (auto-generated if absent)
  //   PROFILE_SIGNING_KEY       - optional; PEM private key to sign .mobileconfig profiles with
  //   PROFILE_SIGNING_CERT      - optional; PEM certificate chain for that key (leaf first)
  //                               (when both are set they take precedence over the automatic
  //                               Let's Encrypt certificate managed from the admin UI)
}
