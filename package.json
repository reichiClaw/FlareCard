{
  "name": "flarecard",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, read-only CardDAV server for a shared company address book. Runs on Cloudflare Workers and open-source workerd.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && wrangler dev --port 47321",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "npm run build:ui && npm run build:worker",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build:ui && wrangler deploy",
    "workerd": "npm run build && workerd serve workerd.capnp",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.mjs",
    "dav:smoke": "bash scripts/dav-smoke.sh"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
