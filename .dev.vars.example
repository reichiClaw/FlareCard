# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
ADMIN_BOOTSTRAP_PASSWORD=change-me-please
# Optional: HMAC key for admin session cookies. Generated and persisted in the DO if omitted.
# SESSION_SECRET=
# Optional: public hostname used in .mobileconfig profiles (defaults to the request Host header).
# PUBLIC_HOST=contacts.example.com
# Optional: sign .mobileconfig profiles with your own certificate (PEM; \n for newlines or
# a quoted multi-line value). Leave unset to use the automatic ACME certificate.
# PROFILE_SIGNING_KEY=
# PROFILE_SIGNING_CERT=
# Optional: ACME directory for automatic signing certificates. wrangler.jsonc sets ZeroSSL;
# override here, e.g. with the Let's Encrypt staging directory for local tests.
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# Required for ZeroSSL / Google Trust Services: External Account Binding credentials.
# ZeroSSL: dashboard -> Developer -> "EAB Credentials for ACME Clients" -> Generate.
# ACME_EAB_KID=
# ACME_EAB_HMAC_KEY=
